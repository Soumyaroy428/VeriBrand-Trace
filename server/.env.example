# ==============================================================================
# VeriBrand Trace - Backend Environment Configuration Example
# ==============================================================================

APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/veribrand

# Security / JWT
JWT_SECRET=super-secret-development-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vector Retrieval
VECTOR_STORE_PROVIDER=pgvector
VECTOR_DATABASE_URL=

# Storage
PRIVATE_STORAGE_PATH=./uploads
